# Development image for the composer (orchestrator) stack. It only provides
# Node; the source is bind-mounted at /app and dependencies live in a named
# volume, so `npm run dev` gives hot reload exactly like the other local apps.
# Production uses ./Dockerfile instead.
FROM node:22-slim
# Pre-create the mount point owned by `node` (uid 1000, same as the WSL user)
# so the named node_modules volume is writable and bind-mounted files created
# by the container stay owned by the host user.
RUN mkdir -p /app/node_modules && chown -R node:node /app
WORKDIR /app
USER node
EXPOSE 5173
