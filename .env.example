# PostgreSQL connection string. The database is a separate, already existing
# container/server - it is never part of the app container.
# Host-run dev: the shared `postgres-server` container from the composer repo,
# published on the WSL host at 5433, with a dedicated elektro_user/elektro DB.
# (see DATABASE_MULTI_APP_GUIDE.md there). Never use the postgres superuser.
# The dev container gets its own DATABASE_URL from the composer repo.
# Inside the compose network the host would be `postgres:5432` instead.
DATABASE_URL=postgresql://elektro_user:change-me@localhost:5433/elektro

# Secret used by better-auth to sign sessions. MUST be replaced: the app
# refuses to start with a secret shorter than 16 characters. Generate one with
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public base URL of the app (the URL the browser sees, behind nginx).
BETTER_AUTH_URL=http://localhost:3000

# Port the single Node process listens on.
PORT=3000

# Trust X-Forwarded-* headers. Must be true behind the nginx reverse proxy.
TRUST_PROXY=false

NODE_ENV=development

# Credentials of the first admin created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
